# Plantilla de variables de entorno para backend IC_IV
SERVERPORT=8080
BDURL=mongodb://localhost:27017/iciv_db
ICIV_TRANSPORT=mesh
# UUID logico independiente por sonda, registrados en AURA.
AURA_FRIDGE_DEVICE_ID=
AURA_FREEZER_DEVICE_ID=
AURA_GATEWAY_DEVICE_ID=
# Activar solo tras acordar gateway, metadatos y reporte con la catedra.
AURA_MESH_EXTENSIONS_ENABLED=false

# Broker de AURA. AURA_DEVICE_ID es alias anterior del UUID de heladera.
AURA_DEVICE_ID=
# UUID del bridge para detectar su LWT offline (pedir a la catedra).
AURA_BRIDGE_DEVICE_ID=
# ID estable y exclusivo de esta instancia; no compartir entre dos backends.
MQTT_CLIENT_ID=iciv-backend-laboratorio
# Deshabilitado hasta acordar el protocolo binario y reporte con AURA.
AURA_CONFIG_EXPERIMENTAL=false
# MQTT Broker
MQTTBROKERURL=mqtt://localhost:1883
BROKERUSERNAME=
BROKERPASSW=
MQTTBROKERCAPATH=

# SMTP (envío de mails de alerta - cualquier proveedor SMTP genérico: Gmail, Outlook, institucional, etc.)
SMTPHOST=
SMTPPORT=
SMTPSECURE=
SMTPUSER=
SMTPPASS=
SMTPFROM=
