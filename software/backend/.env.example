# Plantilla de variables de entorno para backend IC_IV
SERVERPORT=8080
BDURL=mongodb://localhost:27017/iciv_db

# Broker de AURA (no ChirpStack). Completar URL y UUID con la catedra.
AURA_DEVICE_ID=
# Deshabilitado hasta acordar el protocolo binario y reporte con AURA.
AURA_CONFIG_EXPERIMENTAL=false
# MQTT Broker
MQTTBROKERURL=mqtt://localhost:1883
BROKERUSERNAME=
BROKERPASSW=
MQTTBROKERCAPATH=

# SMTP (envío de mails de alerta - cualquier proveedor SMTP genérico: Gmail, Outlook, institucional, etc.)
SMTPHOST=
SMTPPORT=
SMTPSECURE=
SMTPUSER=
SMTPPASS=
SMTPFROM=