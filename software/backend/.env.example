# Plantilla de variables de entorno para backend IC_IV
SERVERPORT=8080
BDURL=mongodb://localhost:27017/iciv_db
ICIV_TRANSPORT=mesh
# Un UUID AURA para toda la placa con ambas sondas.
AURA_DEVICE_ID=
AURA_GATEWAY_DEVICE_ID=
MQTT_CLIENT_ID=iciv-backend-laboratorio
AURA_CONFIG_EXPERIMENTAL=false
# En mesh, este backend usa el broker LOCAL del espejo, separado de AURA.
# MQTT Broker
MQTTBROKERURL=mqtt://localhost:1883
BROKERUSERNAME=
BROKERPASSW=
MQTTBROKERCAPATH=

# SMTP (envío de mails de alerta - cualquier proveedor SMTP genérico: Gmail, Outlook, institucional, etc.)
SMTPHOST=
SMTPPORT=
SMTPSECURE=
SMTPUSER=
SMTPPASS=
SMTPFROM=
